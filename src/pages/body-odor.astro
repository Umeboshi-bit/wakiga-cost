];
const RED = [
 ['息が果物や除光液のようなにおいがし、強いのどの渇き・尿の増加・吐き気・腹痛・深く速い呼吸などを伴う', '糖尿病性ケトアシドーシス（緊急の治療が必要とされる）', r(5,6)],
 ['腐った魚のようなにおいが汗・息・尿などから続く', 'トリメチルアミン尿症（代謝の病気。尿検査で調べる）。重い肝臓病・腎臓病に伴う場合もあるとされる', r(7,8)],
