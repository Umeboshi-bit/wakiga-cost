---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { rows, stats, bothSides, d } from '../data/util.js';
import { yen } from '../data/meta.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const st = (t, f = () => true) => stats(rows(() => true, [t]).filter(x => f(x.p)).map(x => bothSides(x.p)).filter(v => v != null));
const ins = st('senjo_ins'), mira = st('miradry'), botoxSelf = st('botox', p => p.insurance !== true);
const S = [
 ['日本医科大学武蔵小杉病院 形成外科「ワキガ（腋臭症）の治療〜ニオイの診断と手術〜」（日常でできる「ワキガ対策」）', 'https://www.nms.ac.jp/kosugi-h/section/plastic-surgery/guide_wakiga.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q5 腋臭症（ワキガ）はどんな病気ですか？」', 'https://qa.dermatol.or.jp/qa32/q05.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q8 外用薬はどんなものがありますか？」', 'https://qa.dermatol.or.jp/qa32/q08.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q9 外用療法を教えてください。」', 'https://qa.dermatol.or.jp/qa32/q09.html'],
];
const r = (...n) => n.map(i => `[${i}]`).join('');
const STEPS = [
 ['こまめにシャワーを浴びる', '汗や皮脂を洗い流し、においのもとになる分泌物と細菌を減らす', r(1,2)],
 ['入浴の際、薬用せっけんを使用する', '皮膚表面の細菌を減らす洗浄の一つとして、病院の生活指導で挙げられている', r(1,2)],
 ['日中、アルコール綿で拭く', '外出先での拭き取り。肌の弱い方には勧めないとされている', r(1)],
 ['制汗剤は、皮脂と細菌を減らした状態のときに使う', '入浴・拭き取りのあと、清潔な肌に使うという順番がポイント', r(1)],
 ['脱毛をする', 'ワキ毛に汗や皮脂がとどまりにくくする', r(1)],
 ['天然素材の衣類にする', '衣類の素材を見直す', r(1)],
 ['生活リズムを整える', '日常生活全体の見直し', r(1)],
];
const FAQ = [
 ['ワキガのにおいは自分で対策できますか？', 'においは「汗や脂などの分泌物＋皮膚表面の細菌」が原因とされ、日本皮膚科学会のQ&Aでは、洗浄などでいつもワキを清潔に保つことが予防に必要とされています。病院の生活指導では、こまめなシャワー、薬用せっけん、清潔な状態での制汗剤の使用などが挙げられています。ただし体質（アポクリン腺の量など）そのものを変えるものではありません。'],
 ['薬用石鹸とデオドラントクリームはどちらを使えばいいですか？', '役割が異なります。石鹸は体を洗って汗・皮脂や細菌を落とすもの、クリームなどの制汗剤・デオドラント剤は洗ったあとの清潔な肌に使うものです。病院の生活指導でも「入浴時の薬用せっけん」と「皮脂・細菌が減った状態での制汗剤」が別の項目として挙げられています。効能・効果は製品ごとにパッケージの表示で確認してください。'],
 ['市販品で様子を見てもいいのはどんなときですか？', 'においが気になり始めた段階で日常のケアを試す方は多いですが、においが強い・長く続く・人に指摘される・日常生活に支障がある場合は、皮膚科や形成外科で相談できます。においの程度は問診やガーゼ法などで確認する病院があります。'],
 ['病院で処方される塗り薬はありますか？', '日本皮膚科学会のQ&Aでは、汗を抑える目的で保険適用の外用抗コリン薬（原発性腋窩多汗症の診断が必要）や、保険適用外の塩化アルミニウム外用が紹介されています。においそのものの治療薬として承認されたものではないため、医師に相談してください。'],
 ['セルフケアで足りない場合の治療費はいくらですか？', `当サイトの掲載データ（各クリニック公式サイトの掲載値）では、両脇換算の中央値で、保険適用の剪除法（3割負担）${ins ? yen(ins.med) : '—'}、ミラドライ${mira ? yen(mira.med) : '—'}、ボトックス注射（自費）${botoxSelf ? yen(botoxSelf.med) : '—'}でした。医療機関や条件で大きく異なるため、必ず受診先で確認してください。`],
];
---
<Base title="ワキガのにおい対策｜セルフケアと薬用石鹸・デオドラントクリームの選び方" description="ワキガのにおい対策を、大学病院の生活指導と日本皮膚科学会の公開情報で整理。シャワー・薬用せっけん・制汗剤を使う順番、市販品の選び方、セルフケアで足りないときの治療費の目安（公式掲載値）まで。広告・PRを含みます。" crumbs={[['ワキガのにおい対策（セルフケア）', '']]} faq={FAQ}>
<div class="adlabel" role="note"><b>広告・PR</b>　このページには、A8.netのアフィリエイトプログラムによる広告リンクが含まれます。リンク経由で商品が購入されると、当サイトが報酬を受け取る場合があります。</div>
<h1>ワキガのにおい対策：セルフケアと薬用石鹸・デオドラントクリームの選び方</h1>
<p>「病院に行く前に、自分でできるにおい対策は？」「石鹸とクリーム、何をどう使えばいい？」という疑問を、<b>大学病院（形成外科）の生活指導と日本皮膚科学会の公開情報</b>をもとに整理しました。［ ］番号はページ下部の出典に対応しています。</p>
<div class="card" style="border-color:#e0c97f;background:#fffdf3"><b>ご注意</b>：本ページは一般的な情報で、効果を保証するものではありません。市販品はにおいや汗を<b>防ぐ・抑える</b>ためのもので、体質を変えるものではありません。においが強い・長く続く・日常生活に支障がある場合は、皮膚科・形成外科などの医師にご相談ください。</div>

<h2>まず知っておきたい：においの原因</h2>
<p>ワキガのにおいは、ワキなどにあるアポクリン腺の汗に含まれる成分が、<b>皮膚の表面の細菌に分解される</b>ことで生じるとされています。{r(2)} 病院の説明でも、においは「<b>汗や脂などの分泌物＋細菌</b>」が原因とされています。{r(1)} そのため日常のケアは、<b>①分泌物と細菌を洗い流す → ②清潔な状態で汗を抑える</b>という順番で考えるのが基本です。日本皮膚科学会のQ&Aでも、ワキガの予防には洗浄などでいつもワキを清潔に保つ必要があるとされています。{r(2)}</p>

<h2>日常でできるワキガ対策（大学病院の生活指導）</h2>
<p>日本医科大学武蔵小杉病院 形成外科では、においの原因を考慮した生活指導として、次の項目を挙げています。{r(1)}</p>
<div style="overflow-x:auto"><table><tr><th>#</th><th>対策</th><th>ねらい（当サイトによる補足）</th><th>出典</th></tr>
{STEPS.map((x, i) => <tr><td>{i + 1}</td><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td></tr>)}</table></div>
<p class="note">食べ物とにおいの関係については、赤身肉や動物性脂肪などがにおいを増強するという報告はあるものの、現時点では十分な科学的根拠はなく関連性は不明瞭とされています。{r(1)}</p>

<h2>市販品を選ぶときの確認ポイント</h2>
<ol>
<li><b>「洗う」ものか「塗る」ものかを分ける</b>：石鹸は体を洗うもの、クリームなどの制汗剤・デオドラント剤は洗ったあとの清潔な肌に使うものです。{r(1)}</li>
<li><b>「医薬部外品（薬用）」の表示と効能・効果を確認する</b>：医薬部外品は、製品ごとに承認された効能・効果がパッケージに表示されています。化粧品との違いは<a href={`${B}/products/`}>市販品の選び方</a>にまとめています。</li>
<li><b>肌に合うかを確認する</b>：かぶれ・かゆみなどが出た場合は使用をやめ、皮膚科に相談してください。アルコール綿での拭き取りは、肌の弱い方には勧められていません。{r(1)}</li>
</ol>

<h2 id="ad-products">掲載商品【広告・PR】</h2>
<p class="note">以下は広告です。使う場面（洗う／塗る）の順に並べており、おすすめ順・順位ではありません。効能・効果、使い方、価格、成分は、必ずリンク先の販売ページと製品パッケージの表示でご確認ください。当サイトは各メーカー・販売店の公式サイトではありません。</p>
<div class="card" id="anise-soap"><span class="prtag">PR</span> <b>洗う：アニセ 薬用デオドラント石鹸</b><br>
入浴時に体を洗う、固形石鹸タイプのデオドラント製品です（販売：株式会社イワミズ）。<br>
<a href="https://px.a8.net/svt/ejp?a8mat=4BEK9F+CCQTO2+3IE0+1BN3TU" rel="nofollow sponsored noopener" target="_blank" class="btn">アニセ薬用石鹸専門店</a>
<img border="0" width="1" height="1" src="https://www18.a8.net/0.gif?a8mat=4BEK9F+CCQTO2+3IE0+1BN3TU" alt=""></div>
<div class="card" id="anise-cream"><span class="prtag">PR</span> <b>塗る：アニセ ワキガ対策クリーム</b><br>
洗ったあとのワキに使う、クリームタイプのデオドラント製品です（販売：株式会社イワミズ）。<br>
<a href="https://px.a8.net/svt/ejp?a8mat=4BEK9F+CC5E2A+3IE0+5AJ50I" rel="nofollow sponsored noopener" target="_blank" class="btn">アニセ ワキガ対策クリーム</a>
<img border="0" width="1" height="1" src="https://www14.a8.net/0.gif?a8mat=4BEK9F+CC5E2A+3IE0+5AJ50I" alt=""></div>
<p class="note">手のひらの汗が気になる方は<a href={`${B}/hand-sweat/`}>手汗の治療と費用・市販の手汗ジェル</a>をご覧ください。</p>

<h2>セルフケアで足りないと感じたら：受診と費用の目安</h2>
<p>においの程度は、病院では問診のほか、ワキにガーゼを挟んでにおいを確認する「ガーゼ法」や、他人に指摘されたことがあるかなどで総合的に判断されます。{r(1)} 汗を抑える目的では、保険適用の外用抗コリン薬（原発性腋窩多汗症の診断が必要）や、保険適用外の塩化アルミニウム外用が紹介されています。{r(3,4)} 手術は、医師が腋臭症と診断した場合に保険適用となるとされています。{r(1)}</p>
<table><tr><th>治療（当サイトの掲載データ）</th><th>両脇換算の中央値</th><th>範囲</th><th>件数</th></tr>
{[['剪除法（保険・3割負担）', '/insurance/', ins], ['ミラドライ（自費）', '/price/miradry/', mira], ['ボトックス注射（自費・1回）', '/price/botox/', botoxSelf]].filter(x => x[2]).map(([l, h, x]) => <tr><td><a href={`${B}${h}`}>{l}</a></td><td><b>{yen(x.med)}</b></td><td>{yen(x.min)}〜{yen(x.max)}</td><td>{x.n}件</td></tr>)}</table>
<p class="note">各クリニック公式サイトの掲載値（確認日：{d.checked_at}、追加分は各院の確認日）から算出した単純な目安です。片側表記は2倍、単位不明は除外。税込/税抜が混在し、初診料・麻酔代・薬代などが別途かかる場合があります。どの治療が適しているか、保険が使えるかは医師の診察で判断されます。</p>
<p><a class="btn" href={`${B}/check/`}>傾向チェック</a> <a class="btn" href={`${B}/compare/`}>治療法の費用比較</a> <a class="btn" href={`${B}/clinics/`}>料金データベース</a></p>

<Faq faq={FAQ} />

