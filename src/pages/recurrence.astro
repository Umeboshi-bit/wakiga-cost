---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { rows, stats, bothSides, d } from '../data/util.js';
import { yen } from '../data/meta.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const st = (t, f = () => true) => stats(rows(() => true, [t]).filter(x => f(x.p)).map(x => bothSides(x.p)).filter(v => v != null));
const ins = st('senjo_ins'), self = st('senjo'), mira = st('miradry'), botox = st('botox', p => p.insurance !== true);
// 2回目の料金：clinics.json の note に「2回目○円」と記載のある掲載値のみ
const second = rows(() => true, ['miradry']).map(x => {
  const m = (x.p.note || '').match(/2回目([\d,]+)円/);
  return m ? { ...x, second: Number(m[1].replace(/,/g, '')) } : null;
}).filter(Boolean).sort((a, b) => a.second - b.second);
// 他院で受けた治療後の再手術：label に「再手術」を含む掲載値
const redo = rows(() => true, ['senjo', 'senjo_ins']).filter(x => /再手術/.test(x.p.label));
const S = [
 ['日本大学医学部附属板橋病院「腋臭症（わきが）」', 'https://www.itabashi.med.nihon-u.ac.jp/search/term/93'],
 ['兵庫医科大学病院 みんなの医療ガイド「原発性腋窩（えきか）多汗症」', 'https://www.hosp.hyo-med.ac.jp/disease_guide/detail/112'],
 ['中頭病院 形成外科「形成外科シリーズ⑫ 腋臭症」', 'https://www.nakagami.or.jp/shinryoka/geka_keisei/19440/'],
 ['日本医科大学武蔵小杉病院 形成外科「ワキガ（腋臭症）の治療〜ニオイの診断と手術〜」', 'https://www.nms.ac.jp/kosugi-h/section/plastic-surgery/guide_wakiga.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q9 外用療法を教えてください。」', 'https://qa.dermatol.or.jp/qa32/q09.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q11 A型ボツリヌス菌毒素製剤の局所注射療法はどうですか？」', 'https://qa.dermatol.or.jp/qa32/q11.html'],
 ['PMDA 添付文書「ボトックス注用50単位／100単位」（A型ボツリヌス毒素製剤, PDF）', 'https://www.pmda.go.jp/PmdaSearch/iyakuDetail/ResultDataSetPDF/340278_1229404D1020_1_15'],
 ['PMDA 添付文書「miraDryシステム」（医療機器, PDF）', 'https://www.pmda.go.jp/PmdaSearch/kikiDetail/ResultDataSetPDF/340679_23000BZX00161000_1_01_04'],
 ['形成外科と美容外科のクリニック池袋「ワキガは保険適用で治せる？」（よくある質問：再発した場合の再手術と保険）', 'https://keisei-biyou.com/blog/wakigahoken-2'],
 ['形成外科と美容外科のクリニック池袋「ワキガ手術後に再発する原因とは？」（再手術の注意点・タイミング）', 'https://keisei-biyou.com/blog/wakiga-surgery-recurrence'],
 ['日本橋形成外科「自費診療・料金表」（再手術（他院）もしくは自費の剪除法）', 'https://www.nihonbashi-ps.jp/price3.html'],
 ['あさひ美容外科「料金表」（ミラドライ2回目、他院の治療で再発した方の再手術の記載）', 'https://asahi-biyou.or.jp/price/index.html'],
];
const r = (...n) => n.map(i => `[${i}]`).join('');
const WHY = [
 ['アポクリン腺の残存', 'アポクリン腺が残っていると再発する可能性があると説明されています', r(2)],
 ['汗腺の再生・後戻り', '汗腺は術後1〜2か月で再生するため、症状の後戻りが生じることがあると説明する病院があります。汗の分泌量は一時的に減少しても、徐々に元に戻る傾向があるとする病院もあります', r(1,3)],
 ['思春期の変化', '思春期はアポクリン汗腺の分泌がホルモンの影響を受けやすく、手術で減ったにおいが再び増えることもあり得るとされています。若い年齢でマイクロ波・超音波などの機器治療を行った場合、思春期以降ににおいが出る可能性があると案内する病院もあります', r(3,4)],
 ['ワキ以外のにおい', '胸など、ワキ以外のアポクリン汗腺からにおう場合に、再びにおいを感じることがあると説明するクリニックがあります', r(9)],
 ['においの感じ方', 'においの程度の確認は医師の主観的判断でもあり、気にしすぎ（自己臭症）の場合もあるとされています。術後の変化を自分で判断しにくいという問題も挙げられています', r(4)],
];
const OPT = [
 ['手術（剪除法など）のあと', '再手術（保険か自費かは診察で判断）。前回の手術から半年〜1年程度あけることが一般的とするクリニックがあります。癒着があるため初回より慎重な処置が必要とされます', r(9,10)],
 ['ミラドライなど機器治療のあと', '再照射（2回目の料金を設定している院がある）、または手術などほかの治療の相談', r(8,12)],
 ['ボトックス注射の効果が切れた', '再注射。効果は通常4〜9か月で消失し、投与を繰り返す必要がある（再投与は16週以上あける）と添付文書に記載', r(6,7)],
 ['塗り薬（塩化アルミニウムなど）をやめた', '中止すると再発することがあるとされ、外用の再開・継続を医師と相談', r(5)],
];
const FAQ = [
 ['ワキガの手術をしても再発することはありますか？', 'あり得ます。アポクリン腺が残っている場合や、術後に汗腺が再生して症状の後戻りが生じる場合があると大学病院などが説明しています。思春期はホルモンの影響でにおいが変化しやすいともされています。どの治療でも結果には個人差があり、においが再び気になる場合は医師に相談してください。'],
 ['再手術にも保険は使えますか？', '再手術の扱いは、においの程度や前回の手術の内容によって異なり、診察での確認が必要とされています。他院で受けた治療後の再手術を自費のメニューとして掲載している医療機関もあります。保険診療か自費かは、受診先の医療機関に確認してください。'],
 ['再手術はいつから受けられますか？', '前回の手術から半年〜1年程度の期間をあけることが一般的と説明するクリニックがあります。組織が硬い状態での再手術は出血などのリスクが高まるとされているため、時期は医師と相談してください。'],
 ['ミラドライの2回目はいくらですか？', `当サイトの掲載データのうち、2回目の料金を掲載している院は${second.length}件で、両ワキ${second.length ? `${yen(second[0].second)}〜${yen(second[second.length - 1].second)}` : '—'}でした（1回目とは別料金）。条件や含まれる費用は院ごとに異なるため、各公式サイトで確認してください。`],
 ['再発したら、どこに相談すればいいですか？', 'まず治療を受けた医療機関に相談する方法のほか、皮膚科・形成外科で診察を受ける方法があります。受診の際は、前回の手術の時期や内容がわかるもの（説明書・領収書など）を持参すると、状態を確認しやすくなるとされています。'],
];
---
<Base title="ワキガ治療後に再発したら？再手術・追加治療の費用" description={`ワキガ（腋臭症）の手術やミラドライ・ボトックスのあとに、においや汗が再び気になる理由と、再手術・再照射・再注射の考え方と費用を、大学病院・日本皮膚科学会・PMDA添付文書・クリニック公式ページの公開情報で整理。ミラドライ2回目の掲載値${second.length}件を掲載。`} crumbs={[['ワキガ治療後の再発と再治療の費用', '']]} faq={FAQ}>
<h1>ワキガ治療後に再発したら？再手術・追加治療の費用</h1>
<p>「手術したのに、またにおう気がする」「ミラドライやボトックスのあと、汗やにおいが戻ってきた」という場合に知っておきたいことを、<b>大学病院・日本皮膚科学会・PMDA（医薬品医療機器総合機構）の添付文書・クリニック公式ページの公開情報</b>をもとに整理しました。［ ］番号はページ下部の出典に対応しています。費用は当サイトが各クリニック公式サイトから集めた掲載値です。</p>
<div class="card" style="border-color:#e0c97f;background:#fffdf3"><b>ご注意</b>：本ページは一般的な情報で、特定の治療を勧めたり効果を保証したりするものではありません。<b>どの治療にも、においや汗が残る・再び気になる可能性があり、結果には個人差があります。</b>再治療が必要か、どの方法が適しているかは医師の診察で判断されます。費用は医療機関ごとに異なるため、必ず各医療機関で確認してください。</div>

<h2>まとめ：再発が気になったときの3つのポイント</h2>
<ol>
<li><b>手術後も「後戻り」はあり得る</b>：アポクリン腺の残存や汗腺の再生により、症状が再び出ることがあると大学病院などが説明しています。{r(1,2,3)}</li>
<li><b>治療法によって「再発」の意味が違う</b>：ボトックス注射は効果が一時的で、繰り返す前提の治療です。{r(6,7)} 手術・機器治療のあとの再治療とは考え方が異なります。</li>
<li><b>再手術の保険・費用は院と状態による</b>：再手術の扱いは前回の手術内容などによって異なり、診察での確認が必要とされています。{r(9)} 他院治療後の再手術を自費メニューとして掲載する院もあります。{r(11,12)}</li>
</ol>

<h2>なぜ再びにおう？公開情報で挙げられている理由</h2>
<div style="overflow-x:auto"><table><tr><th>理由</th><th>説明</th><th>出典</th></tr>
{WHY.map(x => <tr><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td></tr>)}</table></div>
<p class="note">学生・未成年の方の治療時期の考え方は<a href={`${B}/student/`}>学生・未成年のワキガ治療</a>にまとめています。においより汗の量が気になる場合は、多汗症の治療が対象になることがあります（<a href={`${B}/tahansho/`}>ワキガと多汗症の違い</a>）。</p>

<h2>治療法別：再び気になったときの選択肢</h2>
<div style="overflow-x:auto"><table><tr><th>受けた治療</th><th>一般的な選択肢・考え方</th><th>出典</th></tr>
{OPT.map(x => <tr><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td></tr>)}</table></div>
<p class="note">再手術は、前回の処置による癒着（組織同士が硬くくっつくこと）があり、無理に剥がすと皮膚の血流が悪くなって皮膚壊死などの合併症につながる懸念があると説明されています。{r(10)} ボトックス注射を長期間繰り返した場合、中和抗体の産生により効果が認められなくなることがあると添付文書に記載されています。{r(7)} ミラドライの国内での使用目的は「重度の原発性腋窩多汗症を治療するため」とされています。{r(8)}</p>

<h2>再治療の費用の目安（当サイトの掲載データ）</h2>
<h3>ミラドライ：2回目の料金を掲載している院</h3>
{second.length > 0 ? <>
<table><tr><th>クリニック</th><th>1回目（公式表記）</th><th>2回目</th><th>出典</th></tr>
{second.map(({c, p, checked, second: s2}) => <tr><td><a href={`${B}/clinics/${c.id}/`}>{c.name}</a><div class="note">{c.prefectures.join('・')}</div></td><td>{p.label}：{yen(p.price)}（{p.unit}）{p.note && <div class="note">{p.note}</div>}</td><td><b>{yen(s2)}</b></td><td class="note"><a href={p.src || c.url} rel="nofollow noopener" target="_blank">公式</a> {checked}</td></tr>)}</table>
<p class="note">2回目の料金が適用される条件（期間・同じ院での1回目の施術など）や、含まれる費用は院ごとに異なります。掲載は2回目の料金の低い順で、おすすめ順・順位ではありません。</p>
</> : <p>現在、2回目の料金を掲載している院のデータはありません。</p>}

<h3>他院で受けた治療後の再手術</h3>
{redo.length > 0 ? <>
<table><tr><th>クリニック</th><th>メニュー（公式表記）</th><th>掲載値</th><th>出典</th></tr>
{redo.map(({c, p, checked}) => <tr><td><a href={`${B}/clinics/${c.id}/`}>{c.name}</a><div class="note">{c.prefectures.join('・')}</div></td><td>{p.label}{p.note && <div class="note">{p.note}</div>}</td><td>{p.approx ? '約' : ''}{yen(p.price)}（{p.unit}）</td><td class="note"><a href={p.src || c.url} rel="nofollow noopener" target="_blank">公式</a> {checked}</td></tr>)}</table>
</> : <p>現在、再手術の料金を個別に掲載している院のデータはありません。</p>}
<p class="note">他院の治療で再発した方の再手術を別料金として掲載している院もあります（料金は各公式サイトでご確認ください）。{r(12)}</p>

<h3>初回の治療費の目安（参考）</h3>
<table><tr><th>治療</th><th>両脇換算の中央値</th><th>範囲</th><th>件数</th></tr>
<tr><td><a href={`${B}/insurance/`}>剪除法（保険・3割負担）</a></td><td><b>{yen(ins.med)}</b></td><td>{yen(ins.min)}〜{yen(ins.max)}</td><td>{ins.n}件</td></tr>
<tr><td><a href={`${B}/price/senjo/`}>自費の手術</a></td><td><b>{yen(self.med)}</b></td><td>{yen(self.min)}〜{yen(self.max)}</td><td>{self.n}件</td></tr>
<tr><td><a href={`${B}/price/miradry/`}>ミラドライ（自費・1回目）</a></td><td><b>{yen(mira.med)}</b></td><td>{yen(mira.min)}〜{yen(mira.max)}</td><td>{mira.n}件</td></tr>
<tr><td><a href={`${B}/price/botox/`}>ボトックス注射（自費・1回）</a></td><td><b>{yen(botox.med)}</b></td><td>{yen(botox.min)}〜{yen(botox.max)}</td><td>{botox.n}件</td></tr></table>
<p class="note">各クリニック公式サイトの掲載値（確認日：{d.checked_at}、追加分は各院の確認日）から算出。片側表記は2倍した単純計算、単位不明は除外。保険診療の金額は各院が掲載している目安で、初診料・検査料・薬代などが別途かかる場合があります。再治療・追加照射の費用は含みません。ボトックスを続ける場合の総額は<a href={`${B}/simulator/`}>5年総額シミュレーター</a>で試算できます。</p>
<p><a class="btn" href={`${B}/compare/`}>治療法の費用比較</a> <a class="btn" href={`${B}/clinics/`}>料金データベース</a></p>

<h2>再発が気になるときの相談の進め方</h2>
<ol>
<li><b>前回の治療の記録を用意する</b>：前回の手術の時期や内容がわかるものを持って受診するよう案内するクリニックがあります。{r(9)}</li>
<li><b>治療を受けた医療機関に相談する</b>：再診や追加の処置など、効果が不十分な場合や再発が疑われる場合の対応は院ごとに異なるため、治療前に確認しておくことが大切とされています。{r(10)} 保証制度の有無・条件も院によって違います。</li>
<li><b>皮膚科・形成外科で状態を確認する</b>：においの程度の確認（ガーゼ法など）や、汗の量（多汗症）の問題かどうかは診察で判断されます。{r(4)} 手術の保険適用の条件は<a href={`${B}/insurance-conditions/`}>保険適用の条件</a>をご覧ください。</li>
<li><b>日常のケアも見直す</b>：シャワー・薬用せっけん・衣類の素材など、生活でできる対策を案内する病院があります。{r(4)} 市販品の選び方は<a href={`${B}/products/`}>市販品のページ</a>にまとめています。</li>
</ol>
<p>術後の生活の目安は<a href={`${B}/senjo-recovery/`}>剪除法の術後スケジュール</a>、治療法ごとのしくみは<a href={`${B}/guide/`}>治療法ガイド</a>をご覧ください。</p>

<Faq faq={FAQ} />

<h2>関連ページ</h2>
<ul><li><a href={`${B}/tahansho/`}>ワキガと多汗症の違いと治療費（保険適用・ボトックス・外用薬）</a></li>
<li><a href={`${B}/insurance-conditions/`}>ワキガ手術の保険適用の条件</a></li>
<li><a href={`${B}/compare/`}>ミラドライ・手術・ボトックスの費用比較</a></li></ul>

<h2>出典</h2>
<ol>{S.map(s => <li><a href={s[1]} rel="noopener" target="_blank">{s[0]}</a></li>)}</ol>
<p class="note">出典の確認日：2026-10-20。制度・添付文書・各院の料金や条件は変わることがあります。本ページは体験談・症例写真・ランキング・効果の保証を掲載していません。出典として引用した医療機関と当サイトに広告関係はありません。</p>
</Base>
