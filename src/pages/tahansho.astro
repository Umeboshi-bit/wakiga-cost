---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { rows, stats, bothSides, d } from '../data/util.js';
import { yen } from '../data/meta.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const st = (t, f = () => true) => stats(rows(() => true, [t]).filter(x => f(x.p)).map(x => bothSides(x.p)).filter(v => v != null));
const ins = st('senjo_ins'), self = st('senjo'), mira = st('miradry');
const botoxIns = st('botox', p => p.insurance === true), botoxSelf = st('botox', p => p.insurance !== true);
const botoxInsRows = rows(() => true, ['botox']).filter(x => x.p.insurance === true);
const S = [
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q4 原発性局所多汗症の症状は？」', 'https://qa.dermatol.or.jp/qa32/q04.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q5 腋臭症（ワキガ）はどんな病気ですか？」', 'https://qa.dermatol.or.jp/qa32/q05.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q6 重症度の判定は？」', 'https://qa.dermatol.or.jp/qa32/q06.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q7 多汗症の治療法は？」', 'https://qa.dermatol.or.jp/qa32/q07.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q8 外用薬はどんなものがありますか？」', 'https://qa.dermatol.or.jp/qa32/q08.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q9 外用療法を教えてください。」', 'https://qa.dermatol.or.jp/qa32/q09.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q11 A型ボツリヌス菌毒素製剤の局所注射療法はどうですか？」', 'https://qa.dermatol.or.jp/qa32/q11.html'],
 ['兵庫医科大学病院 みんなの医療ガイド「原発性腋窩（えきか）多汗症」', 'https://www.hosp.hyo-med.ac.jp/disease_guide/detail/112'],
 ['日本医科大学武蔵小杉病院 形成外科「ワキガ（腋臭症）の治療〜ニオイの診断と手術〜」', 'https://www.nms.ac.jp/kosugi-h/section/plastic-surgery/guide_wakiga.html'],
 ['中頭病院 形成外科「形成外科シリーズ⑫ 腋臭症」', 'https://www.nakagami.or.jp/shinryoka/geka_keisei/19440/'],
 ['PMDA 添付文書「ボトックス注用50単位／100単位」（A型ボツリヌス毒素製剤, PDF）', 'https://www.pmda.go.jp/PmdaSearch/iyakuDetail/ResultDataSetPDF/340278_1229404D1020_1_15'],
 ['PMDA 添付文書「ラピフォートワイプ2.5%」（原発性腋窩多汗症治療剤, PDF）', 'https://www.pmda.go.jp/PmdaSearch/iyakuDetail/ResultDataSetPDF/730155_1259701X1026_1_03'],
 ['エクロックゲル5% 添付文書情報（KEGG MEDICUS掲載）', 'https://www.kegg.jp/medicus-bin/japic_med?japic_code=00068993'],
 ['PMDA 添付文書「miraDryシステム」（医療機器, PDF）', 'https://www.pmda.go.jp/PmdaSearch/kikiDetail/ResultDataSetPDF/340679_23000BZX00161000_1_01_04'],
 ['PMDA「miraDryシステム」審議結果報告書・審査報告書（平成30年, PDF）', 'https://www.pmda.go.jp/medical_devices/2018/M20180611001/340679000_23000BZX00161000_A100_1.pdf'],
 ['厚生労働省「別表第一 医科診療報酬点数表」（令和８年度改定, PDF）K008 腋臭症手術', 'https://www.mhlw.go.jp/content/12400000/001686842.pdf'],
];
const COST = [
 ['ボトックス注射（保険・3割負担）', '/price/botox/', botoxIns],
 ['ボトックス注射（自費・1回）', '/price/botox/', botoxSelf],
 ['ミラドライ（自費）', '/price/miradry/', mira],
 ['剪除法（保険・3割負担）', '/insurance/', ins],
 ['自費の手術', '/price/senjo/', self],
].filter(x => x[2]);
const r = (...n) => n.map(i => `[${i}]`).join('');
const DIFF = [
 ['主な悩み', 'ワキのにおい', 'ワキの汗の量'],
 ['関わる汗腺・しくみ', 'アポクリン腺（ワキ・外陰部などにあり、思春期に性ホルモンの影響で分泌が増える）の汗の成分が、皮膚表面の細菌に分解されてにおう', '原因がはっきりしないまま、精神的緊張や温熱刺激で左右対称にワキの下に多汗がみられる（下着やシャツにしみができるほど）'],
 ['頻度の目安', '日本人などでは約10%', '—'],
 ['診察での確認方法の例', '問診、ワキにガーゼを挟んでにおいを確認する「ガーゼ法」、他人に指摘されたことがあるか', '6か月以上続く過剰な発汗＋6項目中2項目以上で診断。重症度は自覚症状の4段階（HDSS）や発汗量の測定で判定'],
 ['保険が使える主な治療', '腋臭症と診断された場合の手術（K008 腋臭症手術：皮弁法など）', '外用抗コリン薬（塗り薬・シート）、重度の場合のボトックス注射'],
];
const DIFF_SRC = [r(2,9), r(2,1,8), r(2), r(9,8,3), r(9,16,5,7)];
const TX = [
 ['塩化アルミニウム外用', '腋窩多汗症には単純外用で有効とされ、多汗症の外用療法の第1選択', '保険適用外の薬剤', '中止すると再発することがある。かぶれ（刺激性皮膚炎）に注意', r(4,5,6,8)],
 ['外用抗コリン薬（エクロックゲル、ラピフォートワイプ）', '原発性腋窩多汗症に対する保険適用薬。1日1回、毎日塗る（拭く）', '原発性腋窩多汗症の確定診断が行われた場合に処方', '閉塞隅角緑内障・前立腺肥大のある方は使用できない', r(5,6,12,13)],
 ['ボツリヌス毒素（ボトックス）注射', '多汗症の第2選択。片ワキあたり50単位を10〜15か所に皮内注射（添付文書）', '2012年11月から重度の原発性腋窩多汗症で保険適用', '効果は通常4〜9か月で消失し、繰り返す必要がある（対症療法）。再投与は16週以上あける', r(4,7,11)],
 ['マイクロ波（ミラドライ）', '国内での使用目的は「重度の原発性腋窩多汗症を治療するため」', '自費（自由診療）として案内されている', '承認審査で腋臭症患者の臨床試験は安全性のみの評価資料とされた', r(9,14,15)],
 ['手術（剪除法・皮弁法など）', 'においの原因のアポクリン腺を取り除く手術', '医師が腋臭症と診断した場合に保険適用（自費メニューの院もある）', '圧迫固定・運動制限が必要。血腫・皮膚の壊死などの合併症あり', r(8,9,16)],
];
const FAQ = [
 ['ワキガと多汗症は同じものですか？', '別の状態として区別されています。ワキガ（腋臭症）はアポクリン腺の汗の成分が皮膚の細菌に分解されて生じる「におい」の悩み、原発性腋窩多汗症は「汗の量」が過剰になる状態です。両方が気になる方もおり、どちらに当たるかは医師の診察で判断されます。'],
 ['多汗症の治療でワキガのにおいも減りますか？', '保険で使われる外用抗コリン薬やボトックス注射は、汗を抑える治療として承認されたもので、においの治療薬として承認されたものではありません。においへの影響には個人差があるため、医師に相談してください。'],
 ['ボトックス注射の保険適用の条件は？', '「重度の原発性腋窩多汗症」と診断された場合に保険適用となります。日常生活に頻繁に支障があるような重症の場合とする病院もあります。重症度は自覚症状の4段階（HDSS）などで判定され、においを目的とする場合は自費として案内している医療機関があります。'],
 ['保険のボトックス注射はいくらですか？', `当サイトの掲載データでは、保険3割負担の目安を掲載している院は${botoxIns ? botoxIns.n : 0}件で、両脇${botoxIns ? `${yen(botoxIns.min)}〜${yen(botoxIns.max)}` : '—'}でした。自費の場合は両脇換算の中央値${yen(botoxSelf.med)}です。初診料・薬剤の量などで変わるため、各医療機関で確認してください。`],
 ['ミラドライは多汗症とワキガのどちらの治療ですか？', '国内の医療機器としての使用目的は「重度の原発性腋窩多汗症を治療するため」と添付文書に記載されています。ワキガ（におい）を目的に案内している医療機関もありますが、いずれも自費（自由診療）です。'],
 ['塩化アルミニウムは保険が使えますか？', '日本皮膚科学会のQ&Aでは、保険適用外の薬剤として塩化アルミニウムの20〜50%の溶液が一般的に使われているとされています。扱いは医療機関によって異なるため、受診先で確認してください。'],
];
---
<Base title="ワキガと多汗症の違いと治療費｜保険適用・ボトックス・外用薬" description={`ワキガ（腋臭症）と多汗症（原発性腋窩多汗症）の違い、保険が使える治療（外用抗コリン薬・ボトックス注射・手術）と自費の治療を、日本皮膚科学会・大学病院・PMDA添付文書の公開情報で整理。ボトックス注射（自費）は${botoxSelf.n}件の掲載値で両脇換算の中央値${yen(botoxSelf.med)}。`} crumbs={[['ワキガと多汗症の違いと治療費', '']]} faq={FAQ}>
<h1>ワキガと多汗症の違いと治療費（保険適用・ボトックス・外用薬）</h1>
<p>「においが気になるのはワキガ？それとも汗が多いだけ？」「保険が使えるのはどれ？」という疑問について、<b>日本皮膚科学会・大学病院・PMDA（医薬品医療機器総合機構）の添付文書など公的・医療機関の公開情報</b>をもとに整理しました。［ ］番号はページ下部の出典に対応しています。費用は当サイトが各クリニック公式サイトから集めた掲載値です。</p>
<div class="card" style="border-color:#e0c97f;background:#fffdf3"><b>ご注意</b>：本ページは一般的な情報で、特定の治療を勧めたり効果を保証したりするものではありません。<b>ワキガ・多汗症のどちらに当たるか、保険が使えるか、どの治療が適しているかは、医師の診察で判断されます。</b>費用は医療機関ごとに異なるため、必ず各医療機関で確認してください。</div>

<h2>まとめ：違いの3つのポイント</h2>
<ol>
<li><b>悩みの中心が違う</b>：ワキガ（腋臭症）は「におい」、原発性腋窩多汗症は「汗の量」の悩みで、医療機関では区別されています。{r(2,10)}</li>
<li><b>保険の対象になる治療が違う</b>：ワキガは診断された場合の手術、多汗症は塗り薬（外用抗コリン薬）や重度の場合のボトックス注射が保険の対象です。{r(5,7,9,16)}</li>
<li><b>両方が気になる人もいる</b>：腋窩多汗症がワキガの原因になると説明する病院もあり、{r(8)} どちらの治療が合うかは診察で判断されます。</li>
</ol>

<h2>ワキガと多汗症の違い（比較表）</h2>
<div style="overflow-x:auto"><table><tr><th>項目</th><th>ワキガ（腋臭症）</th><th>多汗症（原発性腋窩多汗症）</th><th>出典</th></tr>
{DIFF.map((x, i) => <tr><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td><td>{DIFF_SRC[i]}</td></tr>)}</table></div>
<p class="note">においの感じ方には個人差があり、気にしすぎ（自己臭症）の場合もあれば、本人は気づかず周囲が気にしている場合もあるとされています。{r(9)} 自己判断の目安には<a href={`${B}/check/`}>傾向チェック</a>もありますが、診断の代わりにはなりません。</p>

<h2>多汗症の診断基準と重症度</h2>
<p>原発性腋窩多汗症は、原因不明の過剰な局所性発汗が6か月以上続き、次の6項目中2項目以上を満たす場合に診断するとされています（原発性局所多汗症診療ガイドラインより）。{r(8)}</p>
<ul><li>最初に症状が出たのが25歳以下</li><li>左右対称に発汗がみられる</li><li>睡眠中は発汗が止まっている</li><li>1週間に1回以上、多汗のエピソードがある</li><li>家族歴がある</li><li>それらによって日常生活に支障をきたす</li></ul>
<p>重症度は、自覚症状を「(1)まったく気付かない、邪魔にならない」〜「(4)耐えがたい、いつも邪魔になる」の4段階で評価するHDSSを用い、(3)(4)を重症の指標にしているとされています。発汗量を測定して判定する方法もあります。{r(3)}</p>

<h2>治療法と保険の扱い</h2>
<div style="overflow-x:auto"><table><tr><th>治療</th><th>位置づけ・使い方</th><th>保険の扱い</th><th>注意点</th><th>出典</th></tr>
{TX.map(x => <tr><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td><td>{x[3]}</td><td>{x[4]}</td></tr>)}</table></div>
<p class="note">外用抗コリン薬は1か月程度の連日の外用を行って有効性を評価するとされています。{r(6)} ボトックス注射を長期間繰り返した場合、中和抗体の産生により効果が認められなくなることがあると添付文書に記載されています。{r(11)} 効果・持続期間・副作用には個人差があります。治療法ごとの比較は<a href={`${B}/guide/`}>治療法ガイド</a>もご覧ください。</p>

<h2>費用の目安（当サイトの掲載データ）</h2>
<table><tr><th>治療</th><th>両脇換算の中央値</th><th>範囲</th><th>件数</th></tr>
{COST.map(([label, href, x]) => <tr><td><a href={`${B}${href}`}>{label}</a></td><td><b>{yen(x.med)}</b></td><td>{yen(x.min)}〜{yen(x.max)}</td><td>{x.n}件</td></tr>)}</table>
<p class="note">各クリニック公式サイトの掲載値（確認日：{d.checked_at}、追加分は各院の確認日）から算出。片側表記は2倍した単純計算、単位不明は除外。保険診療の金額は各院が掲載している目安で、初診料・検査料・薬代などが別途かかる場合があります。負担割合（1〜3割）は年齢や加入している保険によって異なります。ボトックスは製剤・単位数が院によって異なり、効果が一時的なため続ける場合は繰り返し費用がかかります（<a href={`${B}/simulator/`}>5年総額シミュレーター</a>）。外用抗コリン薬の薬代は当サイトでは集計していません。</p>
{botoxInsRows.length > 0 && <>
<h3>ボトックス注射の保険3割負担の目安を掲載している院</h3>
<table><tr><th>クリニック</th><th>メニュー（公式表記）</th><th>掲載値</th><th>出典</th></tr>
{botoxInsRows.map(({c, p, checked}) => <tr><td><a href={`${B}/clinics/${c.id}/`}>{c.name}</a><div class="note">{c.prefectures.join('・')}</div></td><td>{p.label}{p.note && <div class="note">{p.note}</div>}</td><td>{p.approx ? '約' : ''}{yen(p.price)}（{p.unit}）</td><td class="note"><a href={p.src || c.url} rel="nofollow noopener" target="_blank">公式</a> {checked}</td></tr>)}</table>
<p class="note">掲載料金の低い順で、おすすめ順・順位ではありません。保険適用は医師の診断によります。</p>
</>}
<p><a class="btn" href={`${B}/price/botox/`}>ボトックスの院別料金を見る</a> <a class="btn" href={`${B}/compare/`}>治療法の費用比較</a> <a class="btn" href={`${B}/clinics/`}>料金データベース</a></p>

<h2>受診の目安と相談先</h2>
<ul>
<li><b>汗の量が主な悩み</b>：皮膚科で多汗症の診察・重症度の判定を受けると、保険の外用薬やボトックス注射の対象になるかがわかります。{r(3,5,7)}</li>
<li><b>においが主な悩み</b>：皮膚科・形成外科でにおいの程度の確認（ガーゼ法など）を受けられる病院があります。{r(9)} 手術の保険適用の条件は<a href={`${B}/insurance-conditions/`}>保険適用の条件</a>にまとめています。</li>
<li><b>日常のケア</b>：ワキガの予防には洗浄などで皮膚表面の細菌を減らし、ワキを清潔に保つことが必要とされています。{r(2)} 市販のデオドラント・制汗剤の選び方は<a href={`${B}/products/`}>市販品のページ</a>をご覧ください。</li>
</ul>

<Faq faq={FAQ} />

<h2>関連ページ</h2>
<ul><li><a href={`${B}/insurance-conditions/`}>ワキガ手術の保険適用の条件</a></li>
<li><a href={`${B}/recurrence/`}>ワキガ治療後に再発したら？再手術・追加治療の費用</a></li>
<li><a href={`${B}/student/`}>学生・未成年のワキガ治療：いつから？親の同意・費用</a></li>
<li><a href={`${B}/guide/`}>治療法ガイド（剪除法・ミラドライ・ボトックスの違い）</a></li></ul>

<h2>出典</h2>
<ol>{S.map(s => <li><a href={s[1]} rel="noopener" target="_blank">{s[0]}</a></li>)}</ol>
<p class="note">出典の確認日：2026-10-20。制度・添付文書は改定されることがあります。本ページは体験談・ランキング・効果の保証を掲載していません。出典として引用した医療機関と当サイトに広告関係はありません。</p>
</Base>
