---
import Base from '../../layouts/Base.astro';
import d from '../../data/clinics.json';
import { T, yen, tax } from '../../data/meta.js';
export function getStaticPaths(){return d.clinics.map(c=>({params:{id:c.id},props:{c}}))}
const { c } = Astro.props;
---
<Base title={`${c.name}のワキガ・多汗症治療料金`}>
<h1>{c.name}</h1>
<p>地域：{c.prefectures.join('・')}{c.branch_note && `（${c.branch_note}）`}</p>
<table><tr><th>治療法</th><th>メニュー</th><th>料金</th><th>単位</th><th>税</th><th>保険</th></tr>
{c.prices.map(p=><tr><td>{T[p.t]}</td><td>{p.label}{p.note&&<div class="note">{p.note}</div>}</td><td>{p.approx?'約':''}{yen(p.price)}</td><td>{p.unit}</td><td>{tax(p.tax_included)}</td><td>{p.insurance?'適用':'自費'}</td></tr>)}</table>
<p class="note">出典：<a href={c.url} rel="nofollow noopener" target="_blank">{c.url}</a>／確認日：{d.checked_at}。料金は変更されることがあります。最新情報・リスク・副作用は必ず公式サイトと診察でご確認ください。</p>
<p><a href={`${import.meta.env.BASE_URL}/clinics/`.replace("//","/")}>← データベースに戻る</a></p>
</Base>
