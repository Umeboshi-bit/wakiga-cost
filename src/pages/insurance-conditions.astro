---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { rows, stats, bothSides, d } from '../data/util.js';
import { yen } from '../data/meta.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const st = t => stats(rows(() => true, [t]).map(x => bothSides(x.p)).filter(v => v != null));
const ins = st('senjo_ins'), self = st('senjo'), mira = st('miradry');
const S = [
 ['日本医科大学武蔵小杉病院 形成外科「ワキガ（腋臭症）の治療〜ニオイの診断と手術〜」', 'https://www.nms.ac.jp/kosugi-h/section/plastic-surgery/guide_wakiga.html'],
 ['日本大学医学部附属板橋病院「腋臭症（わきが）」', 'https://www.itabashi.med.nihon-u.ac.jp/search/term/93'],
 ['兵庫医科大学病院 みんなの医療ガイド「原発性腋窩（えきか）多汗症」', 'https://www.hosp.hyo-med.ac.jp/disease_guide/detail/112'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q7 多汗症の治療法は？」', 'https://qa.dermatol.or.jp/qa32/q07.html'],
 ['厚生労働省「令和８年度診療報酬改定について」', 'https://www.mhlw.go.jp/stf/newpage_67729.html'],
 ['厚生労働省「別表第一 医科診療報酬点数表」（令和８年度改定, PDF）K008 腋臭症手術', 'https://www.mhlw.go.jp/content/12400000/001686842.pdf'],
 ['PMDA 添付文書「ボトックス注用50単位／100単位」（A型ボツリヌス毒素製剤, PDF）', 'https://www.pmda.go.jp/PmdaSearch/iyakuDetail/ResultDataSetPDF/340278_1229404D1020_1_15'],
 ['PMDA 添付文書「ラピフォートワイプ2.5%」（原発性腋窩多汗症治療剤, PDF）', 'https://www.pmda.go.jp/PmdaSearch/iyakuDetail/ResultDataSetPDF/730155_1259701X1026_1_03'],
 ['エクロックゲル5% 添付文書情報（2023年4月改訂 第7版, KEGG MEDICUS掲載）', 'https://www.kegg.jp/medicus-bin/japic_med?japic_code=00068993'],
 ['中頭病院 形成外科「形成外科シリーズ⑫ 腋臭症」', 'https://www.nakagami.or.jp/shinryoka/geka_keisei/19440/'],
];
const r = (...n) => n.map(i => `[${i}]`).join('');
const T = [
 ['剪除法（皮弁法）などの腋臭症手術', '医師が腋臭症と診断を確定した場合に保険適用', '診療報酬点数表に「K008 腋臭症手術（1 皮弁法／2 皮膚有毛部切除術／3 その他のもの）」があります', r(1,2,6)],
 ['ボツリヌス毒素（ボトックス）注射', '「重度の原発性腋窩多汗症」と診断された場合に保険適用', '保険の対象は多汗症（汗の量）の診断。添付文書の用法は「通常、成人には」と記載', r(3,4,7)],
 ['外用抗コリン薬（塗り薬・シート）', '「原発性腋窩多汗症」の確定診断が行われた場合に処方', 'エクロックゲル、ラピフォートワイプ。投与開始時に重症度（HDSS）を明細書に記載するとされています', r(4,8,9)],
 ['塩化アルミニウムローション', '保険適応外とする医療機関がある', '多汗症の外用療法の第1選択とされる治療', r(3,4)],
 ['マイクロ波（ミラドライ）・超音波などの機器治療', '自費', '大学病院の案内でも「その他（自費）」として紹介', r(1)],
];
const FAQ = [
 ['保険にするか自費にするか、自分で選べますか？', '保険が使えるかどうかは、医師が診察で腋臭症（または重度の原発性腋窩多汗症）と診断するかどうかで決まります。希望するだけで保険になるわけではないため、保険診療を行っている医療機関で、症状と希望を伝えて相談してください。'],
 ['保険の手術に必要なものは何ですか？', '一般的には医療機関の受診と医師の診断が前提です。問診のほか、ガーゼをワキに挟んでにおいの程度を確認する方法（ガーゼ法）や、他人ににおいを指摘されたことがあるかなどを判断材料にする病院があります。大学病院などでは紹介状の有無で受付時間が異なる場合があるため、事前に各医療機関の案内を確認してください。'],
 ['保険の剪除法はいくらですか？', `当サイトが集めた各院の公式掲載値では、保険の剪除法（3割負担）は両脇換算の中央値${yen(ins.med)}（範囲${yen(ins.min)}〜${yen(ins.max)}、${ins.n}件）です。初診料・検査料・薬代などが別途かかる場合があり、実際の負担額は医療機関で確認してください。`],
 ['ミラドライは保険が使えますか？', 'マイクロ波（ミラドライ）や超音波などの機器治療は自費（自由診療）として案内されています。'],
 ['保険のボトックス注射は、においにも使えますか？', 'ボトックス注射の保険適用は「重度の原発性腋窩多汗症」（汗の量の病気）が対象です。においを目的とする場合は自費とする医療機関が一般的です。どの治療が適しているかは医師にご相談ください。'],
];
---
<Base title="ワキガ手術の保険適用の条件｜何が必要？どこまで保険？" description={`ワキガ（腋臭症）手術が保険適用になる条件、保険の対象になる治療・ならない治療を、大学病院・厚生労働省・添付文書の公開情報で整理。保険の剪除法は${ins.n}件の公式掲載値で両脇換算の中央値${yen(ins.med)}。`} crumbs={[['保険適用ガイド', `${B}/insurance/`], ['保険適用の条件', '']]} faq={FAQ}>
<h1>ワキガ手術の保険適用の条件：何が必要？どこまで保険？</h1>
<p>「ワキガの手術は保険が使えるの？」「何があれば保険になる？」という疑問について、<b>大学病院・厚生労働省・医薬品の添付文書など公的・医療機関の公開情報</b>をもとに整理しました。各項目の［ ］番号はページ下部の出典に対応しています。費用の数字は当サイトが各クリニック公式サイトから集めた掲載値です。</p>
<div class="card" style="border-color:#e0c97f;background:#fffdf3"><b>ご注意</b>：本ページは一般的な情報で、保険適用になることや治療の効果を保証するものではありません。<b>保険が使えるか・どの治療が適しているかは、医師の診察で判断されます。</b>症状については皮膚科・形成外科などの医師にご相談ください。</div>

<h2>まとめ：保険適用の3つのポイント</h2>
<ol>
<li><b>医師の診断が条件</b>：医師が腋臭症の診断を確定した場合、手術は保険適用となると案内されています。{r(1)} 自分の希望だけで保険になるわけではありません。</li>
<li><b>保険の対象は決まった治療だけ</b>：手術は診療報酬点数表の「腋臭症手術」（皮弁法など）が対象です。{r(6)} 汗の量が主な悩みで「重度の原発性腋窩多汗症」と診断された場合は、ボトックス注射や塗り薬が保険の対象になります。{r(3,4,7,8,9)}</li>
<li><b>機器治療は自費</b>：マイクロ波（ミラドライ）や超音波などの治療は自費として案内されています。{r(1)}</li>
</ol>

<h2>保険になる治療・ならない治療</h2>
<div style="overflow-x:auto"><table><tr><th>治療</th><th>保険の扱い</th><th>補足</th><th>出典</th></tr>
{T.map(x => <tr><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td><td>{x[3]}</td></tr>)}</table></div>
<p class="note">同じ「剪除法」という名前でも、美容クリニックなどでは自費（自由診療）のメニューとして提供されている場合があります。保険診療か自費かは各医療機関に確認してください。</p>

<h2>保険の手術までの一般的な流れ</h2>
<ol>
<li><b>皮膚科・形成外科を受診</b>：程度に応じて、まず手術以外の治療（塩化アルミニウムの外用、ボツリヌス毒素注射など）から始めるとする病院があります。{r(2)}</li>
<li><b>においの程度の確認</b>：問診のほか、ワキにガーゼを挟んでにおいを確認する「ガーゼ法」や、他人ににおいを指摘されたことがあるかを判断材料にする病院があります。気にしすぎ（自己臭症）との区別も行われます。{r(1)}</li>
<li><b>診断・手術の説明</b>：手術は「臭いが強く、発汗量が中等量以上の症例」に行うとする病院があります。{r(2)} 合併症（血腫・感染・皮膚の壊死・傷あとなど）の説明を受けます。{r(1,2)}</li>
<li><b>日帰りか入院か</b>：局所麻酔の日帰り、局所麻酔・全身麻酔での入院など、対応は医療機関によって異なります。{r(1,2,10)}</li>
</ol>
<p>術後の生活の目安は<a href={`${B}/senjo-recovery/`}>剪除法の術後スケジュール</a>にまとめています。</p>

<h2>多汗症（汗の量）の保険診療の条件</h2>
<p>原発性腋窩多汗症は、原因不明の過剰な局所性発汗が6か月以上続き、次の6項目中2項目以上を満たす場合に診断するとされています（原発性局所多汗症診療ガイドラインより）。{r(3)}</p>
<ul><li>最初に症状が出たのが25歳以下</li><li>左右対称に発汗がみられる</li><li>睡眠中は発汗が止まっている</li><li>1週間に1回以上、多汗のエピソードがある</li><li>家族歴がある</li><li>それらによって日常生活に支障をきたす</li></ul>
<p>ボトックス注射は「日常生活に頻繁に支障があるような重症多汗症」の場合に保険適用となると案内されています。{r(3)} 外用抗コリン薬（エクロックゲル、ラピフォートワイプ）は、原発性腋窩多汗症の確定診断が行われた場合にのみ投与するとされています。{r(8,9)} 腋臭症（におい）と多汗症（汗の量）は区別されており、{r(10)} どちらに当たるかは診察で判断されます。</p>

<h2>費用の目安（当サイトの掲載データ）</h2>
<table><tr><th>治療</th><th>両脇換算の中央値</th><th>範囲</th><th>件数</th></tr>
<tr><td><a href={`${B}/insurance/`}>剪除法（保険・3割負担）</a></td><td><b>{yen(ins.med)}</b></td><td>{yen(ins.min)}〜{yen(ins.max)}</td><td>{ins.n}件</td></tr>
<tr><td><a href={`${B}/price/senjo/`}>自費の手術</a></td><td><b>{yen(self.med)}</b></td><td>{yen(self.min)}〜{yen(self.max)}</td><td>{self.n}件</td></tr>
<tr><td><a href={`${B}/price/miradry/`}>ミラドライ（自費）</a></td><td><b>{yen(mira.med)}</b></td><td>{yen(mira.min)}〜{yen(mira.max)}</td><td>{mira.n}件</td></tr></table>
<p class="note">各クリニック公式サイトの掲載値（確認日：{d.checked_at}、追加分は各院の確認日）から算出。片側表記は2倍した単純計算、単位不明は除外。保険診療の金額は各院が掲載している目安で、初診料・検査料・薬代などが別途かかる場合があります。負担割合（1〜3割）は年齢や加入している保険によって異なります。</p>
<p><a class="btn" href={`${B}/insurance/`}>保険の剪除法の院別掲載値を見る</a> <a class="btn" href={`${B}/compare/`}>治療法の費用比較</a></p>

<Faq faq={FAQ} />

<h2>関連ページ</h2>
<ul><li><a href={`${B}/student/`}>学生・未成年のワキガ治療：いつから？親の同意・費用</a></li>
<li><a href={`${B}/insurance/`}>ワキガ手術の保険適用はいくら？（院別の掲載値）</a></li>
<li><a href={`${B}/guide/`}>治療法ガイド（剪除法・ミラドライ・ボトックスの違い）</a></li></ul>

<h2>出典</h2>
<ol>{S.map(s => <li><a href={s[1]} rel="noopener" target="_blank">{s[0]}</a></li>)}</ol>
<p class="note">出典の確認日：2026-10-19。制度・添付文書は改定されることがあります。本ページは体験談・ランキング・効果の保証を掲載していません。出典として引用した医療機関と当サイトに広告関係はありません。</p>
</Base>
