---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { yen } from '../data/meta.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
// 薬価（KEGG MEDICUS 掲載の添付文書情報、確認日 2026-10-21）: アポハイドローション20% 539.9円/g, 18mL(17.28g)
const PRICE_G = 539.9, BOTTLE_G = 17.28;
const bottle = Math.round(PRICE_G * BOTTLE_G);
const bottle3 = Math.round(bottle * 0.3);
const S = [
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q1 多汗症とはどんな病気ですか？」', 'https://qa.dermatol.or.jp/qa32/q01.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q2 原発性局所多汗症の患者さんの頻度は？」', 'https://qa.dermatol.or.jp/qa32/q02.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q4 原発性局所多汗症の症状は？」', 'https://qa.dermatol.or.jp/qa32/q04.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q7 多汗症の治療法は？」', 'https://qa.dermatol.or.jp/qa32/q07.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q8 外用薬はどんなものがありますか？」', 'https://qa.dermatol.or.jp/qa32/q08.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q9 外用療法を教えてください。」', 'https://qa.dermatol.or.jp/qa32/q09.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q10 イオントフォレーシス療法はどんな治療法ですか？」', 'https://qa.dermatol.or.jp/qa32/q10.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q12 交感神経遮断術は有効か」', 'https://qa.dermatol.or.jp/qa32/q12.html'],
 ['アポハイドローション20% 添付文書情報・薬価（KEGG MEDICUS掲載）', 'https://www.kegg.jp/medicus-bin/japic_med?japic_code=00070806'],
];
const r = (...n) => n.map(i => `[${i}]`).join('');
const TX = [
 ['塩化アルミニウム外用（単純外用／密封療法）', '手のひら・足の裏の第1選択。寝る前に塗り、効果が出るまで2〜3週間。手袋などで覆う密封療法も', '保険適用外の薬剤', '中止すると再発することがある。皮膚のかさつき・刺激性皮膚炎に注意', r(4,5,6)],
 ['外用抗コリン薬（アポハイドローション）', '原発性手掌多汗症に処方可能な保険適用薬。1日1回、就寝前に両手のひら全体に塗る（目安：両手でポンプ5押し）', '保険適用', '閉塞隅角緑内障・前立腺肥大などによる排尿障害のある方は使用できない。12歳未満を対象とした臨床試験は実施されていない', r(5,6,9)],
 ['イオントフォレーシス', '手のひら・足の裏の第1選択。水道水に浸して5〜20mAの直流電流を流す。1回20〜30分を8〜12回、その後も週1〜2回', '保険診療が可能', 'ワキの多汗症には効果的ではないとされる', r(4,7)],
 ['ボツリヌス毒素（ボトックス）注射', '第2選択', '保険適用となったのはワキ（腋窩）。手のひら・足の裏は欧米でも保険適用になっていないとされる', '痛みのコントロール、投与単位数の見解が十分に得られていない', r(4)],
 ['胸部交感神経遮断術（ETS）', '手のひらの多汗症のみの第3選択。ほかの治療で効果がない場合', '—', '胸・背中などから汗が増える代償性発汗が日常生活に支障をきたすことがある', r(4,8)],
];
const FAQ = [
 ['手汗がひどいのは病気ですか？', '手のひらなど限られた部位から両側に過剰な汗が出る状態は「原発性局所多汗症」と呼ばれます。日本皮膚科学会のQ&Aによると、原発性手掌多汗症の有病率は人口の約5.3%と報告されており、医療機関にかかる割合は1割以下とされています。病気かどうか、治療が必要かは皮膚科で判断されます。'],
 ['手汗の治療に保険は使えますか？', '使える治療があります。日本皮膚科学会のQ&Aでは、原発性手掌多汗症に対して保険適用の塗り薬（20%オキシブチニン塩酸塩ローション：アポハイドローション）が処方可能となったこと、イオントフォレーシスは保険診療が可能であることが紹介されています。保険適用は医師の診断によります。'],
 ['保険の手汗の塗り薬はいくらくらいですか？', `添付文書情報に掲載の薬価は1gあたり539.9円で、18mL（17.28g）の容器1本の薬剤料は計算上約${yen(bottle)}、3割負担なら約${yen(bottle3)}です。これは薬剤料のみの単純計算で、実際には診察料・処方料・調剤料などが加わり、処方量や負担割合によって変わります。`],
 ['手汗にボトックス注射は保険が使えますか？', '日本皮膚科学会のQ&Aでは、ボツリヌス毒素注射で保険適用となったのはワキ（腋窩）で、手のひら・足の裏は欧米でも保険適用になっていないとされています。自費で行う医療機関もあるため、費用は受診先で確認してください。'],
 ['市販の手汗用ジェルと病院の治療はどう違いますか？', '病院の塗り薬は医師の診断のもとで処方される医薬品で、市販品は医師の処方なしで購入できる製品です。市販品は汗を防ぐ・抑えるためのもので、体質を変えるものではありません。汗の量が多く日常生活に支障がある場合は、市販品で様子を見続けず皮膚科に相談してください。'],
];
---
<Base title="手汗（手掌多汗症）の治療と費用｜保険の塗り薬・イオントフォレーシスと市販の手汗ジェル" description={`手汗（原発性手掌多汗症）の治療法と保険の扱いを日本皮膚科学会の公開情報で整理。保険適用の塗り薬（アポハイドローション）の薬剤料は18mL1本で計算上約${yen(bottle)}（3割負担で約${yen(bottle3)}）。イオントフォレーシス、市販の手汗ジェル（広告・PR）も。`} crumbs={[['手汗の治療と費用', '']]} faq={FAQ}>
<div class="adlabel" role="note"><b>広告・PR</b>　このページには、A8.netのアフィリエイトプログラムによる広告リンクが含まれます。リンク経由で商品が購入されると、当サイトが報酬を受け取る場合があります。</div>
<h1>手汗（手掌多汗症）の治療と費用：保険の塗り薬・イオントフォレーシスと市販の手汗ジェル</h1>
<p>「手汗は病院で治療できる？」「保険は使える？いくらかかる？」という疑問を、<b>日本皮膚科学会の皮膚科Q&Aと添付文書情報（薬価）</b>をもとに整理しました。［ ］番号はページ下部の出典に対応しています。</p>
<div class="card" style="border-color:#e0c97f;background:#fffdf3"><b>ご注意</b>：本ページは一般的な情報で、特定の治療・商品を勧めたり効果を保証したりするものではありません。<b>多汗症かどうか、保険が使えるか、どの治療が適しているかは医師の診察で判断されます。</b></div>

<h2>まとめ</h2>
<ol>
<li><b>手汗は「原発性手掌多汗症」として治療の対象になる</b>：有病率は人口の約5.3%と報告され、医療機関にかかる割合は1割以下とされています。{r(1,2)}</li>
<li><b>保険で使える治療がある</b>：塗り薬（アポハイドローション）とイオントフォレーシスが保険診療で受けられるとされています。{r(5,7)}</li>
<li><b>塗り薬の薬剤料の目安</b>：18mL1本で計算上約{yen(bottle)}（3割負担で約{yen(bottle3)}、薬剤料のみ）。{r(9)}</li>
</ol>

<h2>手のひらの多汗症の症状</h2>
<p>幼少児期〜思春期ころに始まり、精神的緊張で手のひら・足の裏に多量の汗が出るとされています。重い場合はしたたり落ちるほどで、昼間（10〜18時）に多く、睡眠中は止まるのが特徴です。湿った状態が続くと、あせもや、カビ・細菌の感染を起こしやすいとされています。{r(3)}</p>

<h2>治療法と保険の扱い</h2>
<div style="overflow-x:auto"><table><tr><th>治療</th><th>位置づけ・方法</th><th>保険の扱い</th><th>注意点</th><th>出典</th></tr>
{TX.map(x => <tr><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td><td>{x[3]}</td><td>{x[4]}</td></tr>)}</table></div>
<p class="note">「第1選択」などは原発性局所多汗症診療ガイドライン（2023年改訂版）に基づく位置づけとして日本皮膚科学会のQ&Aに記載されているものです。{r(4)} 効果・副作用には個人差があります。</p>

<h2>費用の目安：保険の塗り薬（薬剤料の計算例）</h2>
<table><tr><th>項目</th><th>値</th></tr>
<tr><td>薬価（アポハイドローション20%）</td><td>539.9円／g</td></tr>
<tr><td>容器1本（18mL＝17.28g）の薬剤料（10割）</td><td>約{yen(bottle)}</td></tr>
<tr><td>同・3割負担の場合</td><td><b>約{yen(bottle3)}</b></td></tr></table>
<p class="note">薬価・包装は添付文書情報（KEGG MEDICUS掲載、確認日：2026-10-21）による。上記は<b>薬剤料のみの単純計算</b>で、実際には初診料・再診料・処方料・調剤料などが加わります。1本で何日分になるかは塗布量によって異なり、処方量は医師が決めます。負担割合（1〜3割）は年齢や加入している保険によって異なります。イオントフォレーシスの費用は医療機関でご確認ください（当サイトでは集計していません）。</p>

<h2 id="ad-products">市販の手汗用ジェル【広告・PR】</h2>
<p>病院に行く前に、市販の手汗用制汗ジェルを検討する方もいます。市販品は汗を防ぐ・抑えるためのもので、体質を変えるものではありません。汗の量が多く日常生活に支障がある場合は、皮膚科で相談すると保険の治療の対象になるかがわかります。</p>
<p class="note">以下は広告です。効能・効果、使い方、価格、成分は、必ずリンク先の販売ページと製品パッケージの表示でご確認ください。当サイトはメーカー・販売店の公式サイトではありません。</p>
<div class="card" id="frenara"><span class="prtag">PR</span> <b>フレナーラ</b><br>
手のひらに使う、手汗用の制汗ジェルとして販売されている製品です。<br>
<a href="https://px.a8.net/svt/ejp?a8mat=4BEK9F+B4OQWI+39SK+NWRNM" rel="nofollow sponsored noopener" target="_blank" class="btn">手汗用制汗ジェル　フレナーラ</a>
<img border="0" width="1" height="1" src="https://www16.a8.net/0.gif?a8mat=4BEK9F+B4OQWI+39SK+NWRNM" alt=""></div>
<p class="note">医薬部外品と化粧品の違いなど、市販品の確認ポイントは<a href={`${B}/products/`}>市販品の選び方</a>にまとめています。</p>

<h2>ワキの汗・においも気になる方へ</h2>
<p>ワキの多汗症には、保険適用の塗り薬（エクロックゲル、ラピフォートワイプ）や、重度の場合のボトックス注射があります。{r(5,4)} ワキのにおい（ワキガ）との違いや費用は<a href={`${B}/tahansho/`}>ワキガと多汗症の違いと治療費</a>、日常のにおい対策は<a href={`${B}/self-care/`}>ワキガのにおい対策（セルフケア）</a>をご覧ください。足の裏の汗やにおいは<a href={`${B}/foot-odor/`}>足のにおいの原因と対策</a>にまとめています。</p>

<Faq faq={FAQ} />

<h2>出典</h2>
<ol>{S.map(s => <li><a href={s[1]} rel="noopener" target="_blank">{s[0]}</a></li>)}</ol>
<p class="note">出典の確認日：2026-10-21。薬価・添付文書は改定されることがあります。本ページは体験談・ランキング・効果の保証を掲載していません。出典として引用した学会・情報サイトと当サイトに広告関係はありません（<a href={`${B}/policy/`}>編集方針・広告表記</a>）。</p>
</Base>
