---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { rows, stats, bothSides, d } from '../data/util.js';
import { yen } from '../data/meta.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const st = t => stats(rows(() => true, [t]).map(x => bothSides(x.p)).filter(v => v != null));
const ins = st('senjo_ins'), mira = st('miradry'), botox = st('botox');
const S = [
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q5 腋臭症（ワキガ）はどんな病気ですか？」', 'https://qa.dermatol.or.jp/qa32/q05.html'],
 ['日本大学医学部附属板橋病院「腋臭症（わきが）」', 'https://www.itabashi.med.nihon-u.ac.jp/search/term/93'],
 ['日本医科大学武蔵小杉病院 形成外科「ワキガ（腋臭症）の治療〜ニオイの診断と手術〜」', 'https://www.nms.ac.jp/kosugi-h/section/plastic-surgery/guide_wakiga.html'],
 ['中頭病院 形成外科「形成外科シリーズ⑫ 腋臭症」', 'https://www.nakagami.or.jp/shinryoka/geka_keisei/19440/'],
 ['兵庫医科大学病院 みんなの医療ガイド「原発性腋窩（えきか）多汗症」', 'https://www.hosp.hyo-med.ac.jp/disease_guide/detail/112'],
 ['PMDA 添付文書「ラピフォートワイプ2.5%」（PDF）', 'https://www.pmda.go.jp/PmdaSearch/iyakuDetail/ResultDataSetPDF/730155_1259701X1026_1_03'],
 ['エクロックゲル5% 添付文書情報（2023年4月改訂 第7版, KEGG MEDICUS掲載）', 'https://www.kegg.jp/medicus-bin/japic_med?japic_code=00068993'],
 ['PMDA 添付文書「ボトックス注用50単位／100単位」（PDF）', 'https://www.pmda.go.jp/PmdaSearch/iyakuDetail/ResultDataSetPDF/340278_1229404D1020_1_15'],
 ['法務省「民法（成年年齢関係）改正 Q&A」', 'https://www.moj.go.jp/MINJI/minji07_00238.html'],
 ['品川美容外科「未成年の方へ」', 'https://www.shinagawa.com/agreement/'],
 ['湘南美容クリニック よくある質問「未成年なんですが保護者の承諾書みたいなのがないと手術は受けれないんですか？」', 'https://www.s-b-c.net/qa/n8944.html'],
 ['こども家庭庁「令和7年度『こどもに係る医療費の助成についての調査』」', 'https://www.cfa.go.jp/policies/boshihoken/kodomoiryouhityousa-r7'],
 ['こども家庭庁「こども医療費に対する助成の実施状況（令和7年4月1日現在）」（PDF）', 'https://www.cfa.go.jp/assets/contents/node/basic_page/field_ref_resources/6a9b8926-411c-4044-81aa-d8c26b21aaf5/39db7d2e/20251224policies-boshihoken-kodomoiryouhityousa-r7-01.pdf'],
];
const r = (...n) => n.map(i => `[${i}]`).join('');
const FAQ = [
 ['ワキガの治療は何歳から受けられますか？', '法律などで一律に決まった年齢はなく、症状や治療法によって医療機関の判断が異なります。アポクリン腺は思春期に発達し、思春期はにおいが変化しやすいとされているため、年齢や時期も含めて皮膚科・形成外科の医師に相談してください。'],
 ['中学生・高校生でも保険の治療は受けられますか？', '保険が使えるかは年齢ではなく、医師の診断（腋臭症、または原発性腋窩多汗症など）で決まります。ただし保険で使われる薬の添付文書には年齢に関する記載があり（例：ラピフォートワイプは9歳未満、エクロックゲルは12歳未満の臨床試験は実施していない）、実際に使えるかは医師が判断します。'],
 ['親に内緒で治療できますか？', '18歳未満は民法上の未成年で、契約には原則として親などの同意が必要です。美容クリニックでは、未成年の施術に親権者の同意書や同伴を求めるところがあります。費用や術後の生活の負担もあるため、家族と相談したうえで受診することが勧められます。'],
 ['18歳・19歳は親の同意がいりますか？', '2022年4月1日から成年年齢は18歳になり、18歳・19歳は親の同意なしに契約できるようになりました。ただし医療機関ごとに独自の決まりがある場合もあるため、予約時に確認してください。'],
 ['子どもの医療費助成は使えますか？', 'こども医療費の助成は全ての市区町村で行われていますが、対象年齢・所得制限・自己負担の有無は自治体ごとに異なります。どの医療費が対象になるかは、お住まいの市区町村に確認してください。'],
];
---
<Base title="学生・未成年のワキガ治療：いつから？親の同意・費用の目安" description={`中高生・大学生のワキガ（腋臭症）治療について、受けられる時期の考え方、親の同意が必要な年齢、保険・自費の費用の目安を、学会・大学病院・法務省・こども家庭庁などの公開情報で整理。保険の剪除法は両脇換算の中央値${yen(ins.med)}（${ins.n}件の掲載値）。`} crumbs={[['学生・未成年のワキガ治療', '']]} faq={FAQ}>
<h1>学生・未成年のワキガ治療：いつから？親の同意・費用</h1>
<p>「中学生・高校生でもワキガの治療はできる？」「親の同意はいる？」「いくらかかる？」という疑問について、<b>日本皮膚科学会・大学病院・法務省・こども家庭庁などの公開情報</b>と、当サイトが集めたクリニック公式サイトの掲載料金をもとに整理しました。［ ］番号はページ下部の出典に対応しています。</p>
<div class="card" style="border-color:#e0c97f;background:#fffdf3"><b>ご注意</b>：本ページは一般的な情報で、特定の治療を勧めたり効果を保証したりするものではありません。<b>治療を受けるかどうか・時期・方法は、本人と保護者が医師の説明を受けて決めてください。</b>においの悩みは、まず皮膚科・形成外科などの医師にご相談ください。</div>

<h2>ワキガはいつごろから気になる？</h2>
<ul>
<li>においのもとになるアポクリン腺の分泌は、思春期になると性ホルモンの影響で多くなるとされています。{r(1)} 腋臭症は二次性徴が現れる思春期以降に発症すると説明する病院もあります。{r(2)}</li>
<li>においは、アポクリン腺の汗などの分泌物が皮膚表面の細菌に分解されて生じるため、洗浄などでワキを清潔に保つことが予防になるとされています。{r(1,3)}</li>
<li>においの感じ方には個人差があり、気にしすぎ（自己臭症）の場合もあれば、本人は気づかず周囲が気にしている場合もあるとされています。{r(3)} 一人で悩まず、家族や医師に相談することが大切です。</li>
</ul>

<h2>治療は何歳から？年齢と時期の考え方</h2>
<p>ワキガ治療を受けられる年齢は法律などで一律に決まっておらず、医療機関や治療法によって判断が異なります。公開情報では、次のような点が挙げられています。</p>
<ul>
<li><b>思春期はにおいが変化しやすい</b>：思春期はアポクリン汗腺の分泌がホルモンの影響を受けやすいため、手術で減ったにおいが再び増えたり、逆に手術をしなくても自然に治まったりすることもあり得るとされています。{r(4)}</li>
<li><b>若い年齢での機器治療</b>：マイクロ波・超音波などの自費の機器治療を若い年齢で行った場合、思春期以降ににおいが出る可能性があると案内する病院があります。{r(3)}</li>
<li><b>まずは手術以外から</b>：程度に応じて、まず手術以外の治療（塩化アルミニウムの外用など）から始めるとする病院があります。{r(2)} 多汗症（汗の量）の外用療法では、塩化アルミニウムが第1選択とされています。{r(5)}</li>
</ul>

<h3>保険で使われる薬の添付文書にある年齢の記載</h3>
<table><tr><th>薬（対象）</th><th>添付文書の記載</th><th>出典</th></tr>
<tr><td>ラピフォートワイプ（原発性腋窩多汗症）</td><td>9歳未満の小児等を対象とした臨床試験は実施していない</td><td>{r(6)}</td></tr>
<tr><td>エクロックゲル（原発性腋窩多汗症）</td><td>12歳未満の小児等を対象とした国内臨床試験は実施していない</td><td>{r(7)}</td></tr>
<tr><td>ボトックス注射（重度の原発性腋窩多汗症）</td><td>用法は「通常、成人には」と記載</td><td>{r(8)}</td></tr></table>
<p class="note">いずれも多汗症（汗の量）の診断で使われる薬で、ワキガ（におい）の治療薬として承認されたものではありません。年齢だけで使える・使えないが決まるものではなく、使用の可否は医師が判断します。</p>

<h2>親の同意は必要？</h2>
<ul>
<li><b>18歳未満は未成年</b>：2022年4月1日から民法の成年年齢は18歳です。18歳・19歳は親の同意を得ずに契約できるようになりました。{r(9)} 未成年者が親の同意を得ずに契約した場合、原則として取り消すことができる（未成年者取消権）とされています。{r(9)}</li>
<li><b>クリニックごとのルール</b>：例えば品川美容外科は、未成年の方には全ての施術で親権者の同意書を求め、15歳以下はどんな施術でも親権者の同伴が必要、未成年はローンを組めないと案内しています。{r(10)} 湘南美容クリニックは、18歳未満は保護者の同席が必要と回答しています。{r(11)}</li>
<li><b>保険診療の病院も確認を</b>：保険診療を行う病院・クリニックでも、未成年の受診・手術の同意の扱いは医療機関ごとに異なるため、予約時に確認してください。</li>
</ul>
<p class="note">上記のクリニック名は同意に関するルールの例として、各院の公式ページから引用したもので、推奨ではありません。当サイトと引用先に広告関係はありません。</p>

<h2>費用の目安（当サイトの掲載データ）</h2>
<table><tr><th>治療</th><th>両脇換算の中央値</th><th>範囲</th><th>件数</th></tr>
<tr><td><a href={`${B}/insurance/`}>剪除法（保険・3割負担）</a></td><td><b>{yen(ins.med)}</b></td><td>{yen(ins.min)}〜{yen(ins.max)}</td><td>{ins.n}件</td></tr>
<tr><td><a href={`${B}/price/botox/`}>ワキのボトックス注射（1回）</a></td><td><b>{yen(botox.med)}</b></td><td>{yen(botox.min)}〜{yen(botox.max)}</td><td>{botox.n}件</td></tr>
<tr><td><a href={`${B}/price/miradry/`}>ミラドライ（自費）</a></td><td><b>{yen(mira.med)}</b></td><td>{yen(mira.min)}〜{yen(mira.max)}</td><td>{mira.n}件</td></tr></table>
<p class="note">各クリニック公式サイトの掲載値（確認日：{d.checked_at}、追加分は各院の確認日）から算出。片側表記は2倍した単純計算、単位不明は除外。保険診療の金額は各院が掲載している3割負担の目安で、初診料・検査料・薬代などが別途かかる場合があります。ボトックスの効果は一時的で、続ける場合は繰り返し費用がかかります（<a href={`${B}/simulator/`}>5年総額シミュレーター</a>）。</p>
<h3>こども医療費の助成</h3>
<p>こども家庭庁の調査（令和7年4月1日現在）では、全1,741市区町村がこどもの医療費の助成を行っており、通院の対象年齢を「18歳年度末」までとする市区町村が1,576、入院では1,600でした。所得制限や一部自己負担の有無は自治体によって異なります。{r(12,13)} 対象となる医療費や手続きは、お住まいの市区町村に確認してください。</p>

<h2>学校生活と術後の過ごし方</h2>
<p>保険の剪除法では、術後に数日間の圧迫固定や7日前後の抜糸があり、腕を大きく使う動作やスポーツは術後2〜3週間程度控える目安を示す医療機関があります。体育・部活・試験・行事の予定も含めて、時期を医師と相談しましょう。詳しくは<a href={`${B}/senjo-recovery/`}>剪除法の術後スケジュール</a>（出典つき）をご覧ください。</p>

<h2>相談の進め方</h2>
<ol>
<li><b>家族に相談</b>：受診・費用・術後の生活は家族の協力が必要になることが多いため、まず保護者と話し合いましょう。</li>
<li><b>皮膚科・形成外科を受診</b>：においの程度の確認（ガーゼ法など）や、腋臭症・多汗症のどちらに当たるかは診察で判断されます。{r(3)} 保険が使えるかも医師の診断で決まります（<a href={`${B}/insurance-conditions/`}>保険適用の条件</a>）。</li>
<li><b>治療法・時期・費用の説明を聞く</b>：<a href={`${B}/compare/`}>治療法の費用比較</a>や<a href={`${B}/guide/`}>治療法ガイド</a>で、質問したいことを整理しておくと相談しやすくなります。</li>
</ol>

<Faq faq={FAQ} />

<h2>出典</h2>
<ol>{S.map(s => <li><a href={s[1]} rel="noopener" target="_blank">{s[0]}</a></li>)}</ol>
<p class="note">出典の確認日：2026-10-19。制度・添付文書・各院のルールは変わることがあります。本ページは体験談・ランキング・効果の保証を掲載していません。</p>
</Base>
