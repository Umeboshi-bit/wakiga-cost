---
import Base from '../../layouts/Base.astro';
import PriceTable from '../../components/PriceTable.astro';
import { METHODS, AREAS, rows, stats, bothSides, d } from '../../data/util.js';
import { yen } from '../../data/meta.js';
export function getStaticPaths(){ return Object.keys(AREAS).map(a=>({params:{a}})); }
const { a } = Astro.params;
const A = AREAS[a];
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [['保険適用の剪除法（3割負担）',['senjo_ins']],['自費のワキガ手術',['senjo']],['ミラドライ',['miradry']],['ワキのボトックス注射',['botox']]]
  .map(([label,t]) => { const r = rows(A.match, t); return { label, r, s: stats(r.map(x=>bothSides(x.p)).filter(v=>v!=null)) }; }).filter(s => s.r.length);
const clinicsN = d.clinics.filter(A.match).length;
const total = sections.reduce((n,s)=>n+s.r.length,0);
const desc = `${A.name}に院がある${clinicsN}院のワキガ手術・ミラドライ・ボトックスの料金${total}件を、公式サイトの掲載値から出典URLと確認日つきでまとめました。保険適用の剪除法の自己負担目安もわかります。`;
---
<Base title={`${A.name}のワキガ手術・治療の費用【${clinicsN}院・出典つき】`} description={desc} crumbs={[['料金データベース',`${B}/clinics/`],[A.name,'']]}>
<h1>{A.name}のワキガ手術・治療の費用</h1>
<p>{desc}</p>
<div class="card"><b>治療法ごとの掲載値（両脇換算）</b>
<table><tr><th>治療法</th><th>件数</th><th>中央値</th><th>範囲</th></tr>
{sections.map(s => <tr><td><a href={`#${s.r[0].p.t}`}>{s.label}</a></td><td>{s.r.length}</td><td>{s.s ? yen(s.s.med) : '—'}</td><td>{s.s ? `${yen(s.s.min)}〜${yen(s.s.max)}` : '—'}</td></tr>)}</table>
<p class="note">片側表記は2倍、単位不明は除外した単純計算です。税込/税抜が混在しています。複数の地域に院があるクリニックは、公式サイトの共通料金を掲載しています（院ごとに取扱いや料金が異なる場合があります）。料金確認日：{d.checked_at}（追加分は各行の確認日）。</p></div>
{sections.map(s => <><h2 id={s.r[0].p.t}>{A.name}：{s.label}（{s.r.length}件）</h2><PriceTable rows={s.r} showMethod={false} /></>)}
<h2>治療法ごとの全国一覧</h2>
<ul>{Object.entries(METHODS).map(([k,x]) => <li><a href={`${B}/price/${k}/`}>{x.h1}</a></li>)}</ul>
<h2>ほかの地域</h2>
<p>{Object.entries(AREAS).filter(([k])=>k!==a).map(([k,x]) => <a class="btn" style="margin:.2rem" href={`${B}/area/${k}/`}>{x.name}</a>)}</p>
<p class="note">どの治療が適しているか、保険が使えるかは医師の診察で判断されます。手術前の生活の工夫として市販品を検討する場合は<a href={`${B}/products/`}>市販品の選び方（広告・PRを含みます）</a>をご覧ください。</p>
</Base>
