 ['Ara K, et al. "Foot odor due to microbial metabolism and its control." Canadian Journal of Microbiology 52(4), 2006', 'https://cdnsciencepub.com/doi/full/10.1139/w05-130'],
 ['ほりき皮膚科クリニック「におい」（足のにおい）', 'https://horiki-hifuka-clinic.com/treatment/%e3%81%ab%e3%81%8a%e3%81%84/'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q4 原発性局所多汗症の症状は？」', 'https://qa.dermatol.or.jp/qa32/q04.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q7 多汗症の治療法は？」', 'https://qa.dermatol.or.jp/qa32/q07.html'],
 ['日本皮膚科学会 皮膚科Q&A「汗の病気 Q10 イオントフォレーシス療法はどんな治療法ですか？」', 'https://qa.dermatol.or.jp/qa32/q10.html'],
 ['日本皮膚科学会 皮膚科Q&A「白癬（水虫・たむしなど）Q11 どのような症状があれば、足白癬と考えてよいですか？」', 'https://qa.dermatol.or.jp/qa10/q11.html'],
 ['日本皮膚科学会・日本医真菌学会「皮膚真菌症診療ガイドライン 2025」', 'https://www.dermatol.or.jp/dermatol/wp-content/uploads/2013/08/19e2ae577a696f81acf51fdcc0173e2c.pdf'],
 ['佐藤俊次「点状角質融解症」日経メディカル ワークス', 'https://works.medical.nikkeibp.co.jp/articles/58847/'],
 ['Pitted keratolysis: an infective cause of foot odour. CMAJ 187(7), 2015', 'https://www.cmaj.ca/content/187/7/519'],
];
const r = (...n) => n.map(i => `[${i}]`).join('');
const CARE = [
 ['汗をかく前から、足をこまめに洗う', '指の間を含めて足全体を洗い、足の裏の細菌の数を減らすことが目的。においが出てから洗ってもうまくいかないとされる', r(3)],
 ['洗ったあとはしっかり乾かす', '湿った状態を残さない。特に指の間', r(3)],
 ['こまめに靴を脱いで通気性をよくする', '靴下を長時間履き替えない・通気性の悪い靴を履くと、誰でも数時間で足はにおうとされる', r(3)],
 ['靴下・靴の素材を見直す', '吸水性のよい靴下、革靴より蒸れにくい素材の靴など', r(3)],
 ['靴と靴下をこまめに替える・靴を休ませる', '点状角質融解症の管理でも、靴・靴下の交換や靴のローテーションが重要とされている', r(10)],
 ['衣類（靴下）はこまめに洗濯する', '体臭全般の対策として、石けんと水による洗浄とあわせて挙げられている', r(1)],
];
const DX = [
 ['汗が多い（足の裏の多汗症）', '精神的緊張で足の裏に多量の汗が出る。湿った手足はカビや細菌の感染を起こしやすい', '塩化アルミニウム外用、イオントフォレーシス（いずれも足の裏の第1選択）。足の裏へのボトックス注射は欧米でも保険適用になっていない', r(4,5,6)],
 ['点状角質融解症（細菌の感染）', '足の裏に直径2〜5mmほどの浅いくぼみが多数でき、悪臭や歩行時の痛みを伴うことがある。若年男性に多く、夏の高温多湿で見られやすい', '外用の抗菌薬と、靴・靴下の交換などの生活指導。足白癬（水虫）と見分けるため真菌検査が重要とされる', r(9,10)],
 ['足白癬（水虫）', '指の間がふやける・皮がむける、足の裏の小さな水疱など。かゆみの有無だけでは判断できない', '真菌検査で診断を確定してから、抗真菌薬の外用などで治療する', r(7,8)],
];
const FAQ = [
 ['足のにおいの原因は何ですか？', '汗そのものは、皮膚の細菌や真菌に分解されていない状態では悪臭を生じず、分解されるとにおいが生じるとされています。足のにおいについては、皮膚の常在菌である表皮ブドウ球菌が汗に含まれるロイシンを分解してできる「イソ吉草酸」が原因物質の一つと報告されています。靴や靴下で蒸れやすいことも、細菌が増えやすい理由とされています。'],
 ['足のにおいは自分で対策できますか？', '皮膚科の解説では、汗をかく前から足をこまめに洗って足の裏の細菌を減らす、洗ったあとはしっかり乾かす、靴を脱いで通気性をよくする、吸水性のよい靴下や蒸れにくい靴を選ぶ、といった継続的なケアが挙げられています。体質や病気によるものは、セルフケアだけでは変わらないことがあります。'],
 ['洗ってもにおうときは病気の可能性がありますか？', '足の裏の多汗症、点状角質融解症（細菌の感染で足の裏に小さなくぼみができ、悪臭を伴うことがある）、足白癬（水虫）などが関係していることがあります。くぼみ・皮むけ・水疱・痛みなどがある場合や、ケアを続けても気になる場合は皮膚科で相談してください。水虫かどうかは見た目やかゆみだけでは判断できず、真菌検査で確定するとされています。'],
 ['足の汗が多い場合、病院ではどんな治療がありますか？', '日本皮膚科学会のQ&Aでは、足の裏の多汗症に対して塩化アルミニウム外用とイオントフォレーシスが第1選択とされ、イオントフォレーシスは保険診療が可能とされています。ボトックス注射は第2選択ですが、足の裏は欧米でも保険適用になっていないとされています。'],
 ['足のにおいの治療費はいくらですか？', '当サイトでは足のにおい・足の多汗症の治療費は集計していないため、金額は掲載していません。保険診療か自費かは疾患と治療法によって異なり（例：イオントフォレーシスは保険診療が可能、足の裏へのボトックス注射は保険適用外）、診察料や検査料もかかります。費用は受診先の医療機関で確認してください。'],
 ['ワキガと足のにおいは同じ原因ですか？', 'どちらも汗が皮膚の細菌に分解されて生じる点は共通しますが、ワキガはワキなどにあるアポクリン腺の汗が関係し、足の裏には主にエクリン腺が多く分布しているとされています。ワキのにおいについては、ワキガのセルフケアや治療費のページで解説しています。'],
];
---
<Base title="足のにおい（足臭）の原因と対策｜洗っても臭いときの病気と治療・費用の考え方" description="足のにおいの原因（汗＋細菌、イソ吉草酸）と、皮膚科が勧める日常のケアをMSDマニュアル・日本皮膚科学会などの公開情報で整理。洗ってもにおうときに考えられる多汗症・点状角質融解症・水虫と、保険の扱い。広告・PRを含みます。" crumbs={[['足のにおいの原因と対策', '']]} faq={FAQ}>
<div class="adlabel" role="note"><b>広告・PR</b>　このページには、A8.netのアフィリエイトプログラムによる広告リンクが含まれます。リンク経由で商品が購入されると、当サイトが報酬を受け取る場合があります。</div>
<h1>足のにおい（足臭）の原因と対策・治療費用の考え方</h1>
<p>「毎日洗っているのに足が臭う」「病院で治療できる？保険は使える？」という疑問を、<b>MSDマニュアル家庭版・日本皮膚科学会の皮膚科Q&A・皮膚科医の解説・論文</b>をもとに整理しました。［ ］番号はページ下部の出典に対応しています。</p>
<div class="card" style="border-color:#e0c97f;background:#fffdf3"><b>ご注意</b>：本ページは一般的な情報で、特定の治療・商品を勧めたり効果を保証したりするものではありません。足の皮むけ・くぼみ・水疱・痛みがある場合や、ケアを続けてもにおいが気になる場合は、皮膚科で相談してください。</div>

<h2>まとめ</h2>
<ol>
<li><b>においの原因は「汗＋細菌」</b>：汗は皮膚の細菌や真菌に分解されると悪臭を生じるとされ、足のにおいでは汗の成分から作られる「イソ吉草酸」が原因物質の一つと報告されています。{r(1,2)}</li>
<li><b>日常のケアは「洗う・乾かす・蒸らさない」</b>：汗をかく前から足をこまめに洗い、しっかり乾かし、通気性をよくすることが挙げられています。{r(3)}</li>
<li><b>洗っても続くなら病気が関係していることも</b>：足の裏の多汗症、点状角質融解症、足白癬（水虫）などは皮膚科で診断・治療されます。{r(4,7,9)}</li>
</ol>

<h2>足のにおいの原因</h2>
<p>エクリン腺の汗は、皮膚に普段から生息している細菌や真菌に分解されていない状態では悪臭を生じませんが、分解されると悪臭が生じるとされています。大量の発汗がある人や、皮膚・衣服の不衛生も一因になるとされています。{r(1)} エクリン汗腺は全身にあり、なかでも足の裏に多く分布しているとされます。{r(3)}</p>
<p>足のにおいの成分を調べた研究では、においは<b>イソ吉草酸</b>に由来し、皮膚の常在菌である表皮ブドウ球菌（<i>Staphylococcus epidermidis</i>）が汗に含まれるロイシンを分解することで作られると報告されています。においが強い人の足の裏からは枯草菌（<i>Bacillus subtilis</i>）が検出され、においの増加と関連していたとされています。{r(2)} 靴下を長時間履き替えなかったり、通気性の悪い靴を履いていたりすると、菌が増えて程度の差はあれ誰でも数時間で足はにおうとされ、冬でもこたつやカーペットなどの暖房でにおうことがあるとされています。{r(3)}</p>

<h2>日常でできる足のにおい対策</h2>
<div style="overflow-x:auto"><table><tr><th>#</th><th>対策</th><th>ポイント</th><th>出典</th></tr>
{CARE.map((x, i) => <tr><td>{i + 1}</td><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td></tr>)}</table></div>
<p class="note">体臭全般については、石けんと水で汗の多い部分を洗うと、においの原因になる細菌や真菌を取り除けるとされ、デオドラント剤はにおいを隠し、制汗剤は汗の分泌を減らすものと説明されています。{r(1)} こうしたケアは一度ではなく継続して行うことが勧められています。{r(3)}</p>

<h2>洗ってもにおうとき：考えられる病気と治療</h2>
<div style="overflow-x:auto"><table><tr><th>考えられる状態</th><th>特徴</th><th>主な治療・保険の扱い</th><th>出典</th></tr>
{DX.map(x => <tr><td><b>{x[0]}</b></td><td>{x[1]}</td><td>{x[2]}</td><td>{x[3]}</td></tr>)}</table></div>
<p class="note">どれに当てはまるか、どの治療が適しているかは医師の診察で判断されます。足白癬は、日本人の約7人に1人（足白癬13.7%）が罹患していると推測されています。{r(8)} 足白癬に似た症状の皮膚の病気はいくつもあり、皮膚科専門医でも見ただけでは診断がつかないことが多く、真菌検査で確定する必要があるとされています。{r(7)}</p>

<h2>治療費用の考え方</h2>
<p>当サイトの料金データベースはワキの治療（剪除法・ミラドライ・ボトックス）を対象としており、<b>足のにおい・足の多汗症の治療費は集計していません</b>。そのため金額は掲載していません。費用を考えるときは、次の点を受診先で確認してください。</p>
<table><tr><th>治療</th><th>保険の扱い（公開情報）</th><th>出典</th></tr>
<tr><td>イオントフォレーシス（足の裏の多汗症）</td><td>保険診療が可能</td><td>{r(6)}</td></tr>
<tr><td>ボトックス注射（足の裏）</td><td>欧米でも保険適用になっていないとされる（保険適用はワキ）</td><td>{r(5)}</td></tr>
<tr><td>点状角質融解症・足白癬の治療</td><td>皮膚科で診断後に外用薬などで治療。費用は診察・検査・薬剤により異なる</td><td>{r(8,9)}</td></tr></table>
<p class="note">保険適用の手汗の塗り薬（アポハイドローション）は原発性手掌多汗症（手のひら）が対象です。薬剤料の計算例は<a href={`${B}/hand-sweat/`}>手汗の治療と費用</a>をご覧ください。</p>

<h2 id="ad-products">掲載商品【広告・PR】</h2>
<p class="note">以下は広告です。効能・効果、使い方、価格、成分は、必ずリンク先の販売ページと製品パッケージの表示でご確認ください。市販品はにおいを<b>防ぐ</b>ためのもので、体質や病気を治すものではありません。当サイトはメーカー・販売店の公式サイトではありません。</p>
<div class="card" id="anise-soap"><span class="prtag">PR</span> <b>洗う：アニセ 薬用デオドラント石鹸</b><br>
体を洗う固形の薬用石鹸として販売されている製品で、販売元のページでは足を洗う使い方も案内されています（販売：株式会社イワミズ）。<br>
<a href="https://px.a8.net/svt/ejp?a8mat=4BEK9F+CCQTO2+3IE0+1BO6EQ" rel="nofollow sponsored noopener" target="_blank" class="btn">気になる足の臭いに「アニセ薬用石鹸」</a>
<img border="0" width="1" height="1" src="https://www13.a8.net/0.gif?a8mat=4BEK9F+CCQTO2+3IE0+1BO6EQ" alt=""></div>
<p class="note">医薬部外品と化粧品の違いなど、市販品の確認ポイントは<a href={`${B}/products/`}>市販品の選び方</a>にまとめています。かぶれ・かゆみなどが出た場合は使用をやめ、皮膚科に相談してください。</p>

